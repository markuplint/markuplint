{
	"name": "@markuplint/jsx-parser",
	"version": "5.2.0",
	"description": "JSX parser for markuplint",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/jsx-parser"
	},
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "BSD-2-Clause",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/index.js",
			"types": "./lib/index.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "npx tsc --project tsconfig.build.json",
		"dev": "npx tsc --watch --project tsconfig.build.json",
		"clean": "npx tsc --build --clean tsconfig.build.json"
	},
	"dependencies": {
		"@markuplint/html-parser": "5.2.0",
		"@markuplint/ml-ast": "5.1.1",
		"@markuplint/parser-utils": "5.2.0",
		"@typescript-eslint/types": "8.71.1",
		"@typescript-eslint/typescript-estree": "8.71.1"
	}
}
