{
	"name": "@markuplint/test-tools",
	"version": "5.6.0",
	"description": "A private package for testing in this repository",
	"repository": "git@github.com:markuplint/markuplint.git",
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "MIT",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/index.js",
			"types": "./lib/index.d.ts"
		},
		"./translator-templates": {
			"import": "./lib/translator-templates.js",
			"types": "./lib/translator-templates.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --watch --project tsconfig.build.json",
		"clean": "tsc --build --clean tsconfig.build.json"
	},
	"dependencies": {
		"@vitest/coverage-v8": "5.1.0",
		"browser-resolve": "2.0.0",
		"execa": "10.2.1",
		"glob": "14.0.3",
		"jsdom": "30.1.3",
		"textlint-rule-prh": "6.1.1",
		"type-fest": "5.10.0",
		"typescript": "6.0.3",
		"vitest": "5.1.0"
	},
	"optionalDependencies": {
		"@esbuild/linux-x64": "0.28.2",
		"@esbuild/win32-x64": "0.28.2",
		"@rollup/rollup-linux-x64-gnu": "4.67.4"
	}
}
