{
	"compilerOptions": {
		"types": ["node"],
		"module": "NodeNext",
		"target": "ES2022",
		"strict": true,
		"strictNullChecks": true,
		"strictPropertyInitialization": true,
		"allowSyntheticDefaultImports": true,
		"experimentalDecorators": true,
		"esModuleInterop": true,
		"noImplicitAny": true,
		"noUncheckedIndexedAccess": true,
		"declaration": true,
		"lib": ["dom", "esnext"],
		"skipLibCheck": true,
		"outDir": "./lib",
		"rootDir": "./src"
	},
	"include": ["./src/**/*"],
	"exclude": ["node_modules", "lib", "./src/**/*.spec.ts"]
}
