// https://html.spec.whatwg.org/multipage/grouping-content.html#the-hr-element
// https://www.w3.org/TR/html-aria/#el-hr
// https://w3c.github.io/html-aria/#el-hr
{
	"contentModel": {
		"contents": false
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {
		// MDN dropped the deprecated badge; HTML presentational attrs remain deprecated.
		"align": {
			"deprecated": true
		},
		"color": {
			"deprecated": true
		},
		"noshade": {
			"deprecated": true
		},
		"size": {
			"deprecated": true
		},
		"width": {
			"deprecated": true
		}
	},
	"aria": {
		"implicitRole": "separator",
		"permittedRoles": ["presentation", "none"],
		"properties": {
			"global": true,
			"role": "separator"
		}
	}
}
