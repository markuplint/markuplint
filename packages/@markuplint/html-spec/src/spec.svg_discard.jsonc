// The `discard` element is defined only by SVG Tiny 1.2: SVG Animations Level 2 and SVG 2 no longer define it,
// while browsers still implement it, so this data follows Tiny 1.2 with the SVG 2 names of its attributes.
// https://www.w3.org/TR/SVGTiny12/struct.html#DiscardElement
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [":model(SVGDescriptive)", "svg|script"]
			}
		]
	},
	"globalAttrs": {
		"#ARIAAttrs": true,
		"#SVGConditionalProcessingAttrs": ["requiredExtensions", "systemLanguage"],
		"#SVGCoreAttrs": ["id", "tabindex", "autofocus", "lang", "xml:space", "class", "style"]
	},
	"attributes": {
		// https://www.w3.org/TR/SVGTiny12/struct.html#DiscardElementBeginAttribute
		"begin": {
			"type": "<begin-value-list>",
			"defaultValue": "0s"
		},
		// https://www.w3.org/TR/SVGTiny12/struct.html#DiscardElementHrefAttribute
		"href": {
			"type": "URL"
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false
	}
}
