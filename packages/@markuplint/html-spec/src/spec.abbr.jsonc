// https://html.spec.whatwg.org/multipage/text-level-semantics.html#the-abbr-element
// https://www.w3.org/TR/html-aria/#el-abbr
// https://www.w3.org/TR/html-aam/#el-abbr
{
	"contentModel": {
		"contents": [
			{
				"oneOrMore": ":model(phrasing)"
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {},
	"aria": {
		"implicitRole": false,
		"permittedRoles": true,
		"namingProhibited": true
	}
}
