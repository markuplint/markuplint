// https://html.spec.whatwg.org/multipage/tables.html#the-tfoot-element
// https://www.w3.org/TR/html-aria/#el-tfoot
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": "tr"
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {},
	"aria": {
		"implicitRole": "rowgroup",
		"permittedRoles": true
	}
}
