// https://html.spec.whatwg.org/multipage/grouping-content.html#the-ul-element
// https://www.w3.org/TR/html-aria/#el-ul
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": ["li", ":model(script-supporting)"]
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"compact": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"type": {
			"obsolete": true
		}
	},
	"aria": {
		"implicitRole": "list",
		"permittedRoles": [
			"group",
			"listbox",
			"menu",
			"menubar",
			"none",
			"presentation",
			"radiogroup",
			"tablist",
			"toolbar",
			"tree",
			{
				"name": "directory",
				"deprecated": true
			}
		],
		"1.1": {
			"permittedRoles": [
				"directory",
				"group",
				"listbox",
				"menu",
				"menubar",
				"none",
				"presentation",
				"radiogroup",
				"tablist",
				"toolbar",
				"tree"
			]
		}
	}
}
