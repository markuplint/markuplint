// https://drafts.fxtf.org/filter-effects/#feFuncAElement
// https://www.w3.org/TR/svg-aam/#role-map-fefunca
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [":model(SVGDescriptive)", "svg|animate", "svg|script", "svg|set"]
			}
		]
	},
	"globalAttrs": {
		"#SVGCoreAttrs": ["id", "xml:base", "xml:lang", "xml:space"],
		"#SVGTransferFunctionAttrs": ["type", "tableValues", "slope", "intercept", "amplitude", "exponent", "offset"]
	},
	"attributes": {},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false
	}
}
