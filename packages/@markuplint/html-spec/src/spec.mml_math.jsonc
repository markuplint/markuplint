// https://www.w3.org/TR/mathml-core/#the-top-level-math-element
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [
					":model(MathMLPresentation)",
					"mml|semantics",
					"mml|annotation",
					"mml|annotation-xml",
					"mml|mtr",
					"mml|mtd",
					"mml|mprescripts",
					"#text"
				]
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#MathMLGlobalAttrs": true
	},
	"attributes": {
		// https://www.w3.org/TR/mathml-core/#the-top-level-math-element
		"display": {
			"type": {
				"enum": ["block", "inline"],
				"disallowToSurroundBySpaces": false
			},
			"defaultValue": "inline"
		},
		// https://www.w3.org/TR/mathml-core/#the-top-level-math-element
		"alttext": {
			"type": "Any"
		},
		// https://www.w3.org/TR/mathml-core/#the-top-level-math-element
		"xmlns": {
			"type": "URL"
		}
	},
	"aria": {
		"implicitRole": "math",
		"permittedRoles": false,
		"properties": {
			"global": true,
			"role": "math"
		}
	}
}
