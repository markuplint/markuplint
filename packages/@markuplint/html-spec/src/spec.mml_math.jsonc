// https://www.w3.org/TR/mathml-core/#the-top-level-math-element
{
	"contentModel": {
		"contents": [
			{
				// MathML Core §2.1.1 — only Presentation MathML and <semantics>
				// are valid direct children of <math>. Parent-restricted
				// elements (`<mtr>` §3.5.2 / `<mtd>` §3.5.3 only inside
				// `<mtable>` §3.5.1, `<mprescripts>` §3.4.3 only inside
				// `<mmultiscripts>`, `<annotation>` / `<annotation-xml>`
				// §3.7 only inside `<semantics>`) are intentionally absent
				// here so misplacement fires.
				"zeroOrMore": [
					":model(MathMLPresentation)",
					"mml|semantics",
					"#text"
				]
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#MathMLGlobalAttrs": true
	},
	"attributes": {
		// https://www.w3.org/TR/mathml-core/#the-top-level-math-element
		"display": {
			"type": {
				"enum": ["block", "inline"],
				"disallowToSurroundBySpaces": false
			},
			"defaultValue": "inline"
		},
		// https://www.w3.org/TR/mathml-core/#the-top-level-math-element
		"alttext": {
			"type": "Any"
		},
		// https://www.w3.org/TR/mathml-core/#the-top-level-math-element
		"xmlns": {
			"type": "URL"
		}
	},
	"aria": {
		"implicitRole": "math",
		"permittedRoles": false,
		"properties": {
			"global": true,
			"role": "math"
		}
	}
}
