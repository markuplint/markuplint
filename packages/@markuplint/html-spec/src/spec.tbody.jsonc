// https://html.spec.whatwg.org/multipage/tables.html#the-tbody-element
// https://www.w3.org/TR/html-aria/#el-tbody
{
	"contentModel": {
		"contents": [
			{
				// > Zero or more tr and script-supporting elements.
				// @see https://html.spec.whatwg.org/multipage/tables.html#the-tbody-element
				"zeroOrMore": ["tr", ":model(script-supporting)"]
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {},
	"aria": {
		"implicitRole": "rowgroup",
		"permittedRoles": true
	}
}
