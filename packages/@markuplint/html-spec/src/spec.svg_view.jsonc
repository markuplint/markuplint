// https://svgwg.org/svg2-draft/linking.html#ViewElement
// https://www.w3.org/TR/svg-aam/#role-map-view
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [":model(SVGAnimation)", ":model(SVGDescriptive)", "svg|script", "svg|style"]
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#SVGCoreAttrs": ["id", "tabindex", "autofocus", "lang", "xml:space", "class", "style"]
	},
	"attributes": {
		// https://svgwg.org/svg2-draft/coords.html#ViewBoxAttribute
		"viewBox": {
			"type": "<view-box>"
		},
		// https://svgwg.org/svg2-draft/coords.html#PreserveAspectRatioAttribute
		"preserveAspectRatio": {
			"type": "<preserve-aspect-ratio>"
		},
		// https://svgwg.org/svg2-draft/changes.html#interact
		// SVG 2 removed the attribute (Changes from SVG 1.1).
		"zoomAndPan": {
			"type": {
				"enum": ["disable", "magnify"]
			},
			"defaultValue": "magnify",
			"obsolete": true
		},
		// https://svgwg.org/svg2-draft/changes.html#linking
		// SVG 2 removed the attribute (Changes from SVG 1.1).
		"viewTarget": {
			"type": "Any",
			"obsolete": true
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false
	}
}
