// https://html.spec.whatwg.org/multipage/iframe-embed-object.html#the-iframe-element
// https://www.w3.org/TR/html-aria/#el-iframe
{
	"contentModel": {
		"contents": false
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#HTMLEmbededAndMediaContentAttrs": ["src", "height", "width"],
		"#HTMLLinkAndFetchingAttrs": ["referrerpolicy", "loading"]
	},
	"attributes": {
		// https://html.spec.whatwg.org/multipage/iframe-embed-object.html#attr-iframe-src
		"src": {
			"required": "[itemprop]",
			"ineffective": "[srcdoc]"
		},
		// https://html.spec.whatwg.org/multipage/iframe-embed-object.html#attr-iframe-srcdoc
		"srcdoc": {
			// The type is HTML syntax, but it does not evaluate as HTML.
			"type": "Any"
		},
		// https://html.spec.whatwg.org/multipage/iframe-embed-object.html#attr-iframe-name
		"name": {
			"type": "NavigableTargetName"
		},
		// https://html.spec.whatwg.org/multipage/iframe-embed-object.html#attr-iframe-sandbox
		"sandbox": {
			"type": {
				"token": {
					"enum": [
						"allow-forms",
						"allow-modals",
						"allow-orientation-lock",
						"allow-pointer-lock",
						"allow-popups",
						"allow-popups-to-escape-sandbox",
						"allow-presentation",
						"allow-same-origin",
						"allow-scripts",
						"allow-top-navigation",
						"allow-top-navigation-by-user-activation",
						"allow-downloads",
						"allow-custom-protocols-navigation"
					]
				},
				"caseInsensitive": true,
				"ordered": true,
				"unique": true,
				"separator": "space"
			}
		},
		// https://html.spec.whatwg.org/multipage/iframe-embed-object.html#attr-iframe-allow
		"allow": {
			"type": "SerializedPermissionsPolicy"
		},
		// https://html.spec.whatwg.org/multipage/iframe-embed-object.html#attr-iframe-allowfullscreen
		"allowfullscreen": {
			"type": "Boolean"
		},
		// https://wicg.github.io/trust-token-api/#iframe-private-token
		"privateToken": {
			"type": "Any"
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"longdesc": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"datasrc": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"datafld": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"align": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"allowtransparency": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"frameborder": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"framespacing": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"hspace": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"marginheight": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"marginwidth": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"scrolling": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"vspace": {
			"obsolete": true
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": ["application", "document", "img", "none", "presentation"]
	}
}
