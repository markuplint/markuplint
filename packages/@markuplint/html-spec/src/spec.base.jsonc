// https://html.spec.whatwg.org/multipage/semantics.html#the-base-element
// https://www.w3.org/TR/html-aria/#el-base
{
	"contentModel": {
		"contents": false
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#HTMLLinkAndFetchingAttrs": ["href", "target"]
	},
	"attributes": {
		// @see https://html.spec.whatwg.org/multipage/semantics.html#attr-base-href
		// > There must be no more than one base element per document.
		// > A base element must have either an href attribute, a target attribute, or both.
		"href": {
			// https://html.spec.whatwg.org/multipage/semantics.html#set-the-frozen-base-url
			"type": "BaseURL",
			"requiredEither": ["target"]
		},
		// https://html.spec.whatwg.org/multipage/semantics.html#attr-base-target
		"target": {
			"requiredEither": ["href"]
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false,
		"properties": false
	}
}
