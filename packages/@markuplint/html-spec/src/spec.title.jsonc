// https://html.spec.whatwg.org/multipage/semantics.html#the-title-element
// https://www.w3.org/TR/html-aria/#el-title
// https://w3c.github.io/html-aria/#el-title
{
	"contentModel": {
		// https://html.spec.whatwg.org/multipage/semantics.html#the-title-element
		// "The title element must contain at least one character that is not
		//  inter-element whitespace."
		"contents": [
			{
				"require": "#nonEmptyText"
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false,
		"properties": false
	}
}
