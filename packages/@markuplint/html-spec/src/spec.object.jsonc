// https://html.spec.whatwg.org/multipage/iframe-embed-object.html#the-object-element
// https://www.w3.org/TR/html-aria/#el-object
{
	"contentModel": {
		"contents": [
			{
				"oneOrMore": ":model(flow)"
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#HTMLEmbededAndMediaContentAttrs": ["height", "width"],
		"#HTMLFormControlElementAttrs": ["form"]
	},
	"attributes": {
		// @see https://html.spec.whatwg.org/multipage/iframe-embed-object.html#attr-object-data
		// > a valid non-empty URL potentially surrounded by spaces
		"data": {
			"type": "NonEmptyURL",
			"requiredEither": ["type"]
		},
		// https://html.spec.whatwg.org/multipage/iframe-embed-object.html#attr-object-type
		"type": {
			"type": "MIMEType",
			"requiredEither": ["data"]
		},
		// https://html.spec.whatwg.org/multipage/iframe-embed-object.html#attr-object-name
		"name": {
			"type": "NavigableTargetName"
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"archive": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"border": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"classid": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"codebase": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"codetype": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"declare": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"standby": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"usemap": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"code": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"typemustmatch": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"datasrc": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"datafld": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"dataformatas": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"align": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"hspace": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"vspace": {
			"obsolete": true
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": ["application", "document", "img"]
	}
}
