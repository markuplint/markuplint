// https://html.spec.whatwg.org/multipage/tables.html#the-colgroup-element
// https://www.w3.org/TR/html-aria/#el-colgroup
{
	"contentModel": {
		"contents": [
			{
				// > If the span attribute is absent:
				// > Zero or more col and template elements.
				// @see https://html.spec.whatwg.org/multipage/tables.html#the-colgroup-element
				"zeroOrMore": ["col", "template"]
			}
		],
		"conditional": [
			{
				"condition": "[span]",
				"contents": false
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {
		// https://html.spec.whatwg.org/multipage/tables.html#attr-colgroup-span
		"span": {
			"type": {
				"type": "integer",
				"gt": 0,
				"lte": 1000,
				"clampable": true
			},
			"defaultValue": "1"
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false,
		"properties": false
	}
}
