// https://html.spec.whatwg.org/multipage/tables.html#the-col-element
// https://www.w3.org/TR/html-aria/#el-col
{
	"contentModel": {
		"contents": false
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {
		// https://html.spec.whatwg.org/multipage/tables.html#attr-col-span
		"span": {
			"type": {
				"type": "integer",
				"gt": 0,
				"lte": 1000,
				"clampable": true
			},
			"defaultValue": "1"
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"align": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"char": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"charoff": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"valign": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"width": {
			"obsolete": true
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false,
		"properties": false
	}
}
