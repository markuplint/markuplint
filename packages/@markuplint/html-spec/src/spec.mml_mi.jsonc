// https://www.w3.org/TR/mathml-core/#the-mi-element
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [
					":model(MathMLPresentation)",
					"mml|semantics",
					"mml|annotation",
					"mml|annotation-xml",
					"#text"
				]
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#MathMLGlobalAttrs": true
	},
	"attributes": {
		// https://www.w3.org/TR/mathml-core/#the-mi-element
		"mathvariant": {
			"type": {
				"enum": ["normal"],
				"disallowToSurroundBySpaces": false
			}
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": true
	}
}
