// https://developer.mozilla.org/en-US/docs/Web/MathML/Reference/Element/mfenced
{
	"deprecated": true,
	"nonStandard": true,
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [
					":model(MathMLPresentation)",
					"mml|semantics",
					"mml|annotation",
					"mml|annotation-xml",
					"#text"
				]
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#MathMLGlobalAttrs": true
	},
	"attributes": {
		// https://developer.mozilla.org/en-US/docs/Web/MathML/Reference/Element/mfenced
		"open": {
			"type": "Any",
			"defaultValue": "("
		},
		// https://developer.mozilla.org/en-US/docs/Web/MathML/Reference/Element/mfenced
		"close": {
			"type": "Any",
			"defaultValue": ")"
		},
		// https://developer.mozilla.org/en-US/docs/Web/MathML/Reference/Element/mfenced
		"separators": {
			"type": "Any",
			"defaultValue": ","
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": true
	}
}
