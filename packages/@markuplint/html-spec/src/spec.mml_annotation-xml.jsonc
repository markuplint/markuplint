// https://www.w3.org/TR/mathml-core/#semantics-and-presentation
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [
					":model(MathMLPresentation)",
					"mml|semantics",
					"mml|annotation",
					"mml|annotation-xml",
					"#text"
				]
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#MathMLGlobalAttrs": true
	},
	"attributes": {
		// https://www.w3.org/TR/mathml-core/#semantics-and-presentation
		"encoding": {
			"type": "MIMEType"
		},
		// https://www.w3.org/TR/mathml-core/#semantics-and-presentation
		"src": {
			"type": "URL",
			"deprecated": true
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": true
	}
}
