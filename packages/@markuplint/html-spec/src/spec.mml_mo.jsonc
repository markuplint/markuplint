// https://www.w3.org/TR/mathml-core/#operator-fence-separator-or-accent-mo
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [
					":model(MathMLPresentation)",
					"mml|semantics",
					"mml|annotation",
					"mml|annotation-xml",
					"#text"
				]
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#MathMLGlobalAttrs": true
	},
	"attributes": {
		// https://www.w3.org/TR/mathml-core/#operator-fence-separator-or-accent-mo
		"fence": {
			"type": {
				"enum": ["true", "false"],
				"disallowToSurroundBySpaces": false
			}
		},
		"separator": {
			"type": {
				"enum": ["true", "false"],
				"disallowToSurroundBySpaces": false
			}
		},
		"stretchy": {
			"type": {
				"enum": ["true", "false"],
				"disallowToSurroundBySpaces": false
			}
		},
		"symmetric": {
			"type": {
				"enum": ["true", "false"],
				"disallowToSurroundBySpaces": false
			}
		},
		"largeop": {
			"type": {
				"enum": ["true", "false"],
				"disallowToSurroundBySpaces": false
			}
		},
		"movablelimits": {
			"type": {
				"enum": ["true", "false"],
				"disallowToSurroundBySpaces": false
			}
		},
		"accent": {
			"type": {
				"enum": ["true", "false"],
				"disallowToSurroundBySpaces": false
			}
		},
		"lspace": {
			"type": "<length-percentage>"
		},
		"rspace": {
			"type": "<length-percentage>"
		},
		"minsize": {
			"type": "<length-percentage>"
		},
		"maxsize": {
			"type": "<length-percentage>"
		},
		"form": {
			"type": {
				"enum": ["prefix", "infix", "postfix"],
				"disallowToSurroundBySpaces": false
			}
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": true
	}
}
