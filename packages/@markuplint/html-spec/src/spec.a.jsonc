// https://html.spec.whatwg.org/multipage/text-level-semantics.html#the-a-element
// https://www.w3.org/TR/html-aria/#el-a
// https://www.w3.org/TR/html-aam/#el-a
{
	"contentModel": {
		"contents": [
			{
				"transparent": ":not(:model(interactive), a, [tabindex], :has(:model(interactive), a, [tabindex]))"
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#HTMLLinkAndFetchingAttrs": ["href", "target", "download", "ping", "rel", "hreflang", "type", "referrerpolicy"]
	},
	"attributes": {
		// https://open-ui.org/components/interest-invokers.explainer/
		"interestfor": {
			"type": "DOMID"
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#obsolete-but-conforming-features
		// Obsolete but conforming, which conformance checkers warn about. The value must not be the empty string.
		// The rest of the requirements (the value is unique among the IDs and the name attributes of the tree,
		// and equals the ID of the element when it has one) are not a type.
		"name": {
			"type": "NoEmptyAny",
			"deprecated": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"charset": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"coords": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"shape": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"methods": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"rev": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"urn": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"datasrc": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"datafld": {
			"obsolete": true
		}
	},
	"aria": {
		"implicitRole": "link",
		"permittedRoles": [
			"button",
			"checkbox",
			"menuitem",
			"menuitemcheckbox",
			"menuitemradio",
			"option",
			"radio",
			"switch",
			"tab",
			"treeitem"
		],
		"properties": {
			"global": true,
			"role": true,
			"without": [
				{
					"type": "not-recommended",
					"name": "aria-disabled",
					"value": "true",
					"alt": {
						"method": "remove-attr",
						"target": "href"
					}
				}
			]
		},
		"conditions": {
			":not([href])": {
				"implicitRole": "generic",
				"permittedRoles": true,
				"namingProhibited": true
			}
		},
		"1.1": {
			"conditions": {
				":not([href])": {
					"implicitRole": false
				}
			}
		}
	}
}
