// https://www.w3.org/TR/mathml-core/#radicals-msqrt-mroot
{
	"contentModel": {
		"contents": [
			{
				// MathML Core §3.3.3 — mroot requires exactly two children
				// (base and index).
				"require": [
					":model(MathMLPresentation)",
					"mml|semantics",
					"#text"
				],
				"min": 2,
				"max": 2
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#MathMLGlobalAttrs": true
	},
	"attributes": {},
	"aria": {
		"implicitRole": false,
		"permittedRoles": true
	}
}
