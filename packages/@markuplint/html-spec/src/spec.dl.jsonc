// https://html.spec.whatwg.org/multipage/grouping-content.html#the-dl-element
// https://www.w3.org/TR/html-aria/#el-dl
{
	"contentModel": {
		"contents": [
			{
				"choice": [
					[
						// > Zero or more groups each consisting of
						// > one or more dt elements followed by one or more dd elements,
						// > optionally intermixed with script-supporting elements.
						// @see https://html.spec.whatwg.org/multipage/grouping-content.html#the-dl-element
						//
						// "Intermixed" means a script-supporting element may stand anywhere among the
						// dt and dd elements, so the run of dt (and of dd) after the required first one
						// also accepts it, and the leading one lets a dl hold nothing but those. The
						// required `oneOrMore` stays first so that a missing dt or dd is still reported
						// as "Need dt" / "Need dd". `dl > div` in spec.div.jsonc has the same shape.
						{
							"zeroOrMore": ":model(script-supporting)"
						},
						{
							"zeroOrMore": [
								{
									"oneOrMore": "dt"
								},
								{
									"zeroOrMore": ["dt", ":model(script-supporting)"]
								},
								{
									"oneOrMore": "dd"
								},
								{
									"zeroOrMore": ["dd", ":model(script-supporting)"]
								}
							]
						}
					],
					[
						// > One or more div elements,
						// > optionally intermixed with script-supporting elements.
						// @see https://html.spec.whatwg.org/multipage/grouping-content.html#the-dl-element
						{
							"zeroOrMore": ":model(script-supporting)"
						},
						{
							"oneOrMore": "div"
						},
						{
							"zeroOrMore": ["div", ":model(script-supporting)"]
						}
					]
				]
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {
		"compact": {
			"deprecated": true
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": ["group", "list", "none", "presentation"]
	}
}
