// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
{
	"obsolete": true,
	"contentModel": {
		"contents": true
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {
		// https://html.spec.whatwg.org/multipage/obsolete.html#frames
		"cols": {
			"type": "Any"
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#frames
		"rows": {
			"type": "Any"
		}
	},
	"aria": {
		"permittedRoles": true,
		"implicitRole": false
	}
}
