								}
							}
						]
					}
				},
				"[type='reset' i]": {
					"implicitRole": "button",
					"permittedRoles": [
						"checkbox",
						"link",
						"menuitem",
						"menuitemcheckbox",
						"menuitemradio",
						"option",
