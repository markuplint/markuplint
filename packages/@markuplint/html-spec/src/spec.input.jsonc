					}
				},
				"[type='radio' i]": {
					"implicitRole": "radio",
					"permittedRoles": ["menuitemradio"],
					"properties": {
						"global": true,
						"role": true,
						// Authors SHOULD NOT use the aria-checked attribute on input type=radio elements.
