					"properties": {
						"global": true,
						"role": "spinbutton",
						// Authors SHOULD NOT use the aria-valuemax, aria-valuemin, or aria-valuenow attributes on input type=number.
						"without": [
							{
								"type": "should-not",
								"name": "aria-valuemax",
								"alt": {
									"method": "set-attr",
									"target": "max"
								}
							},
							{
								"type": "should-not",
								"name": "aria-valuemin",
								"alt": {
