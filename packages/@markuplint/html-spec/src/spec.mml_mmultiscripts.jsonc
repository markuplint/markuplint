// https://www.w3.org/TR/mathml-core/#prescripts-and-tensor-indices-mmultiscripts
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [
					":model(MathMLPresentation)",
					"mml|semantics",
					"mml|mprescripts",
					"#text"
				]
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#MathMLGlobalAttrs": true
	},
	"attributes": {
		"subscriptshift": {
			"deprecated": true
		},
		"superscriptshift": {
			"deprecated": true
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": true
	}
}
