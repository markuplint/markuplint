// https://drafts.csswg.org/filter-effects-1/#fePointLightElement
// https://www.w3.org/TR/svg-aam/#role-map-fepointlight
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [":model(SVGDescriptive)", "svg|animate", "svg|script", "svg|set"]
			}
		]
	},
	"globalAttrs": {
		"#SVGCoreAttrs": ["id", "xml:base", "xml:lang", "xml:space"]
	},
	"attributes": {
		// https://drafts.csswg.org/filter-effects-1/#element-attrdef-fepointlight-x
		"x": {
			"type": "<number>",
			"defaultValue": "0",
			"animatable": true
		},
		// https://drafts.csswg.org/filter-effects-1/#element-attrdef-fepointlight-y
		"y": {
			"type": "<number>",
			"defaultValue": "0",
			"animatable": true
		},
		// https://drafts.csswg.org/filter-effects-1/#element-attrdef-fepointlight-z
		"z": {
			"type": "<number>",
			"defaultValue": "0",
			"animatable": true
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false
	}
}
