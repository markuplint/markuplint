// https://html.spec.whatwg.org/multipage/sections.html#the-header-element
// https://www.w3.org/TR/html-aria/#el-header
{
	"contentModel": {
		"contents": [
			{
				"oneOrMore": ":model(flow):not(header, footer, :has(header, footer))"
			}
		],
		// @see https://html.spec.whatwg.org/multipage/sections.html#the-header-element
		// > Flow content, but with no header or footer element descendants.
		// The footer element has the same content model, so a header inside a footer is
		// non-conforming as well.
		"forbiddenAncestors": ["header", "footer"]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {},
	"aria": {
		"implicitRole": "banner",
		"permittedRoles": ["group", "presentation", "none"],
		"conditions": {
			":has(article, aside, main, nav, section, [role=article], [role=complementary], [role=main], [role=navigation], [role=region])": {
				"implicitRole": "generic",
				"namingProhibited": true
			}
		},
		"1.1": {
			"implicitRole": "banner",
			"conditions": {
				":has(article, aside, main, nav, section, [role=article], [role=complementary], [role=main], [role=navigation], [role=region])": {
					"implicitRole": false
				}
			}
		}
	}
}
