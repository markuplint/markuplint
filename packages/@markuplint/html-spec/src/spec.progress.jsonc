// https://html.spec.whatwg.org/multipage/form-elements.html#the-progress-element
// https://www.w3.org/TR/html-aria/#el-progress
{
	"contentModel": {
		"contents": [
			{
				"oneOrMore": ":model(phrasing):not(progress, :has(progress))"
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {
		// @see https://html.spec.whatwg.org/multipage/form-elements.html#attr-progress-value
		// > The value attribute, if present, must have a value greater than or equal to zero, and
		// > less than or equal to the value of the max attribute, if present, or 1.0, otherwise.
		// The cross-attribute `<= max` constraint is not expressible in the type
		// system; we only pin the lower bound here.
		"value": {
			"type": {
				"type": "float",
				"gte": 0
			}
		},
		// @see https://html.spec.whatwg.org/multipage/form-elements.html#attr-progress-max
		// > The max attribute, if present, must have a value greater than zero.
		"max": {
			"type": {
				"type": "float",
				"gt": 0
			}
		}
	},
	"aria": {
		"implicitRole": "progressbar",
		"permittedRoles": false,
		"properties": {
			"global": true,
			"role": "progressbar",
			// Authors SHOULD NOT use the aria-valuemax or aria-valuenow attributes on progress elements.
			"without": [
				{
					"type": "should-not",
					"name": "aria-valuemax",
					"alt": {
						"method": "set-attr",
						"target": "max"
					}
				},
				{
					"type": "should-not",
					"name": "aria-valuenow",
					"alt": {
						"method": "set-attr",
						"target": "value"
					}
				}
			]
		}
	}
}
