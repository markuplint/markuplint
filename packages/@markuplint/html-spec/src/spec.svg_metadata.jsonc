// https://svgwg.org/svg2-draft/struct.html#MetadataElement
// https://www.w3.org/TR/svg-aam/#role-map-metadata
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [":model(SVGDescriptive)", ":model(SVGNeverRendered)", "#text"]
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#SVGCoreAttrs": ["id", "tabindex", "autofocus", "lang", "xml:space", "class", "style"]
	},
	"attributes": {},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false
	}
}
