// https://html.spec.whatwg.org/multipage/grouping-content.html#the-main-element
// https://www.w3.org/TR/html-aria/#el-main
{
	"contentModel": {
		"contents": [
			{
				"oneOrMore": ":model(flow)"
			}
		],
		// @see https://html.spec.whatwg.org/multipage/grouping-content.html#the-main-element
		// > A document must not have more than one main element that does not have the hidden
		// > attribute specified.
		//
		// > A hierarchically correct main element is one whose ancestor elements are limited to
		// > html, body, div, form without an accessible name, and autonomous custom elements.
		// The data does not check this yet: it only forbids the ancestors below.
		"forbiddenAncestors": ["article", "aside", "footer", "header", "nav"]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {},
	"aria": {
		"implicitRole": "main",
		"permittedRoles": false,
		"properties": {
			"global": true,
			"role": "main"
		}
	}
}
