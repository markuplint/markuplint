// https://html.spec.whatwg.org/multipage/text-level-semantics.html#the-bdo-element
// https://www.w3.org/TR/html-aria/#el-bdo
// https://w3c.github.io/html-aria/#el-bdo
{
	"contentModel": {
		"contents": [
			{
				"oneOrMore": ":model(phrasing)"
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {
		// https://html.spec.whatwg.org/multipage/text-level-semantics.html#the-bdo-element
		// "The dir global content attribute is required on this element. The attribute's value must not be the keyword auto."
		"dir": {
			"required": true,
			"type": {
				"enum": ["ltr", "rtl"]
			}
		}
	},
	"aria": {
		"implicitRole": "generic",
		"permittedRoles": true,
		"namingProhibited": true,
		"1.1": {
			"implicitRole": false
		}
	}
}
