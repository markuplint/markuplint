// https://drafts.csswg.org/filter-effects-1/#feMergeNodeElement
// https://www.w3.org/TR/svg-aam/#role-map-femergeNode
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [":model(SVGDescriptive)", "svg|animate", "svg|script", "svg|set"]
			}
		]
	},
	"globalAttrs": {
		"#SVGCoreAttrs": [
			"id",
			"xml:base",
			"xml:lang",
			"xml:space",
			"part",
			"exportparts",
			"slot",
			"nonce",
			"elementtiming"
		],
		"#SVGFilterPrimitiveAttrs": ["in"]
	},
	"attributes": {},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false
	}
}
