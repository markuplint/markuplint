// https://www.w3.org/TR/mathml-core/#string-literal-ms
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [
					":model(MathMLPresentation)",
					"mml|semantics",
					"mml|annotation",
					"mml|annotation-xml",
					"#text"
				]
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#MathMLGlobalAttrs": true
	},
	"attributes": {},
	"aria": {
		"implicitRole": false,
		"permittedRoles": true
	}
}
