// https://html.spec.whatwg.org/multipage/scripting.html#the-script-element
// https://www.w3.org/TR/html-aria/#el-script
// https://w3c.github.io/html-aria/#el-script
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": "#text"
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#HTMLLinkAndFetchingAttrs": ["crossorigin", "referrerpolicy", "integrity", "fetchpriority"]
	},
	// HTML LS §4.12.1: "Which other attributes may be specified on a given
	// script element is determined by the following table:" — the applicability
	// table is normative and permits each attribute only for specific script kinds:
	//
	//                   | nomodule | async | defer | blocking | crossorigin | referrerpolicy | integrity | fetchpriority
	// External classic  |   Yes    |  Yes  |  Yes  |   Yes    |     Yes     |      Yes       |    Yes    |     Yes
	// Inline classic    |   Yes    |   ·   |   ·   |    ·     |     Yes     |      Yes       |     ·     |      ·
	// External module   |    ·     |  Yes  |   ·   |   Yes    |     Yes     |      Yes       |    Yes    |     Yes
	// Inline module     |    ·     |  Yes  |   ·   |    ·     |     Yes     |      Yes       |     ·     |      ·
	// Import maps       |    ·     |   ·   |   ·   |    ·     |      ·      |       ·        |     ·     |      ·
	// Speculation rules |    ·     |   ·   |   ·   |    ·     |      ·      |       ·        |     ·     |      ·
	// Data blocks       |    ·     |   ·   |   ·   |    ·     |      ·      |       ·        |     ·     |      ·
	//
	// The script kind is determined by the type attribute: "Omitting the
	// attribute, setting it to the empty string, or setting it to a JavaScript
	// MIME type essence match means that the script is a classic script";
	// "module" / "importmap" / "speculationrules" (ASCII case-insensitively)
	// select those kinds; any other value is a data block.
	//
	// The JavaScript MIME type essence strings (https://mimesniff.spec.whatwg.org/#javascript-mime-type):
	// application/ecmascript, application/javascript, application/x-ecmascript,
	// application/x-javascript, text/ecmascript, text/javascript,
	// text/javascript1.0 … text/javascript1.5, text/jscript, text/livescript,
	// text/x-ecmascript, text/x-javascript.
	//
	// The selectors below enumerate the classic-script type values because the
	// "data block" kind (any other type value) is not expressible as a finite
	// negative selector list.
	"attributes": {
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-src
		// "It must only be specified for classic scripts and JavaScript module
		// scripts." — not for import maps, speculation rules, or data blocks.
		"src": {
			"type": "NonEmptyURL",
			"condition": ":is(:not([type]), [type=''], [type='module' i], [type='application/ecmascript' i], [type='application/javascript' i], [type='application/x-ecmascript' i], [type='application/x-javascript' i], [type='text/ecmascript' i], [type='text/javascript' i], [type='text/javascript1.0' i], [type='text/javascript1.1' i], [type='text/javascript1.2' i], [type='text/javascript1.3' i], [type='text/javascript1.4' i], [type='text/javascript1.5' i], [type='text/jscript' i], [type='text/livescript' i], [type='text/x-ecmascript' i], [type='text/x-javascript' i])"
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-type
		"type": {
			"type": [
				"MIMEType",
				{
					"enum": ["module", "importmap", "speculationrules"],
					"caseInsensitive": true
				}
			]
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-nomodule
		// §4.12.1 table: "Yes" only for external and inline classic scripts.
		"nomodule": {
			"type": "Boolean",
			"condition": ":is(:not([type]), [type=''], [type='application/ecmascript' i], [type='application/javascript' i], [type='application/x-ecmascript' i], [type='application/x-javascript' i], [type='text/ecmascript' i], [type='text/javascript' i], [type='text/javascript1.0' i], [type='text/javascript1.1' i], [type='text/javascript1.2' i], [type='text/javascript1.3' i], [type='text/javascript1.4' i], [type='text/javascript1.5' i], [type='text/jscript' i], [type='text/livescript' i], [type='text/x-ecmascript' i], [type='text/x-javascript' i])"
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-async
		// §4.12.1 table: "Yes" for external classic scripts and any module script.
		"async": {
			"type": "Boolean",
			"condition": [
				":is(:not([type]), [type=''], [type='application/ecmascript' i], [type='application/javascript' i], [type='application/x-ecmascript' i], [type='application/x-javascript' i], [type='text/ecmascript' i], [type='text/javascript' i], [type='text/javascript1.0' i], [type='text/javascript1.1' i], [type='text/javascript1.2' i], [type='text/javascript1.3' i], [type='text/javascript1.4' i], [type='text/javascript1.5' i], [type='text/jscript' i], [type='text/livescript' i], [type='text/x-ecmascript' i], [type='text/x-javascript' i])[src]",
				"[type='module' i]"
			],
			"ineffective": ":not([src]):not([type='module' i])"
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-defer
		// §4.12.1 table: "Yes" only for external classic scripts.
		"defer": {
			"type": "Boolean",
			"condition": ":is(:not([type]), [type=''], [type='application/ecmascript' i], [type='application/javascript' i], [type='application/x-ecmascript' i], [type='application/x-javascript' i], [type='text/ecmascript' i], [type='text/javascript' i], [type='text/javascript1.0' i], [type='text/javascript1.1' i], [type='text/javascript1.2' i], [type='text/javascript1.3' i], [type='text/javascript1.4' i], [type='text/javascript1.5' i], [type='text/jscript' i], [type='text/livescript' i], [type='text/x-ecmascript' i], [type='text/x-javascript' i])[src]",
			"ineffective": [":not([src])", "[async]"]
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-integrity
		// §4.12.1 table: "Yes" only for external classic and external module scripts.
		"integrity": {
			"condition": ":is(:not([type]), [type=''], [type='module' i], [type='application/ecmascript' i], [type='application/javascript' i], [type='application/x-ecmascript' i], [type='application/x-javascript' i], [type='text/ecmascript' i], [type='text/javascript' i], [type='text/javascript1.0' i], [type='text/javascript1.1' i], [type='text/javascript1.2' i], [type='text/javascript1.3' i], [type='text/javascript1.4' i], [type='text/javascript1.5' i], [type='text/jscript' i], [type='text/livescript' i], [type='text/x-ecmascript' i], [type='text/x-javascript' i])[src]"
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-charset
		// Must not be used without src
		"charset": {
			"condition": "[src]"
		},
		// https://html.spec.whatwg.org/multipage/urls-and-fetching.html#blocking-attributes
		// §4.12.1 table: "Yes" only for external classic and external module scripts.
		"blocking": {
			"type": {
				"token": {
					"enum": ["render"]
				},
				"separator": "space",
				"unique": true
			},
			"condition": ":is(:not([type]), [type=''], [type='module' i], [type='application/ecmascript' i], [type='application/javascript' i], [type='application/x-ecmascript' i], [type='application/x-javascript' i], [type='text/ecmascript' i], [type='text/javascript' i], [type='text/javascript1.0' i], [type='text/javascript1.1' i], [type='text/javascript1.2' i], [type='text/javascript1.3' i], [type='text/javascript1.4' i], [type='text/javascript1.5' i], [type='text/jscript' i], [type='text/livescript' i], [type='text/x-ecmascript' i], [type='text/x-javascript' i])[src]"
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-crossorigin
		// §4.12.1 table: "Yes" for classic and module scripts, external or inline.
		// Table footnote: "Although inline scripts have no initial fetches, the
		// crossorigin and referrerpolicy attribute on inline scripts affects the
		// credentials mode and referrer policy used by module imports, including
		// dynamic import()."
		// The type (enum) definition is inherited from #HTMLLinkAndFetchingAttrs;
		// the per-element merge in ml-spec getAttrSpecs preserves fields that
		// this entry does not specify.
		"crossorigin": {
			"condition": ":is(:not([type]), [type=''], [type='module' i], [type='application/ecmascript' i], [type='application/javascript' i], [type='application/x-ecmascript' i], [type='application/x-javascript' i], [type='text/ecmascript' i], [type='text/javascript' i], [type='text/javascript1.0' i], [type='text/javascript1.1' i], [type='text/javascript1.2' i], [type='text/javascript1.3' i], [type='text/javascript1.4' i], [type='text/javascript1.5' i], [type='text/jscript' i], [type='text/livescript' i], [type='text/x-ecmascript' i], [type='text/x-javascript' i])"
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-referrerpolicy
		// §4.12.1 table: same applicability as crossorigin.
		"referrerpolicy": {
			"condition": ":is(:not([type]), [type=''], [type='module' i], [type='application/ecmascript' i], [type='application/javascript' i], [type='application/x-ecmascript' i], [type='application/x-javascript' i], [type='text/ecmascript' i], [type='text/javascript' i], [type='text/javascript1.0' i], [type='text/javascript1.1' i], [type='text/javascript1.2' i], [type='text/javascript1.3' i], [type='text/javascript1.4' i], [type='text/javascript1.5' i], [type='text/jscript' i], [type='text/livescript' i], [type='text/x-ecmascript' i], [type='text/x-javascript' i])"
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-fetchpriority
		// §4.12.1 table: "Yes" only for external classic and external module
		// scripts. Table footnote: "Unlike crossorigin and referrerpolicy,
		// fetchpriority does not affect module imports."
		"fetchpriority": {
			"condition": ":is(:not([type]), [type=''], [type='module' i], [type='application/ecmascript' i], [type='application/javascript' i], [type='application/x-ecmascript' i], [type='application/x-javascript' i], [type='text/ecmascript' i], [type='text/javascript' i], [type='text/javascript1.0' i], [type='text/javascript1.1' i], [type='text/javascript1.2' i], [type='text/javascript1.3' i], [type='text/javascript1.4' i], [type='text/javascript1.5' i], [type='text/jscript' i], [type='text/livescript' i], [type='text/x-ecmascript' i], [type='text/x-javascript' i])[src]"
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false,
		"properties": false
	}
}
