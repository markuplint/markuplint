// https://html.spec.whatwg.org/multipage/scripting.html#the-script-element
// https://www.w3.org/TR/html-aria/#el-script
// https://w3c.github.io/html-aria/#el-script
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": "#text"
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#HTMLLinkAndFetchingAttrs": ["crossorigin", "referrerpolicy", "integrity", "fetchpriority"]
	},
	"attributes": {
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-src
		// importmap and speculationrules must not have src
		"src": {
			"type": "NonEmptyURL",
			"condition": ":not([type='importmap' i]):not([type='speculationrules' i])"
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-type
		"type": {
			"type": [
				"MIMEType",
				{
					"enum": ["module", "importmap", "speculationrules"],
					"caseInsensitive": true
				}
			]
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-nomodule
		// Must not be used with type=module, importmap, or speculationrules
		"nomodule": {
			"type": "Boolean",
			"condition": ":not([type='module' i]):not([type='importmap' i]):not([type='speculationrules' i])"
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-async
		// Must not be used with importmap or speculationrules
		"async": {
			"type": "Boolean",
			"condition": [":not([type='importmap' i]):not([type='speculationrules' i])[src]", "[type='module' i]"],
			"ineffective": ":not([src]):not([type='module' i])"
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-defer
		// HTML LS §4.12.1 attribute applicability table: `defer` is "Yes" only for
		// external classic scripts; all other script kinds (inline classic, any
		// module, import map, speculation rules, data block) are "·" (not applicable).
		// Known gap: this condition lets `<script type="application/json" src=x defer>`
		// pass (data block is implicitly not module / not importmap / not speculationrules
		// and the type-set has no closed enum). Acceptable for now — no fixture
		// exercises that combination.
		"defer": {
			"type": "Boolean",
			"condition": ":not([type='importmap' i]):not([type='speculationrules' i]):not([type='module' i])[src]",
			"ineffective": [":not([src])", "[async]"]
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-integrity
		// Must not be used with importmap or speculationrules; requires src
		"integrity": {
			"condition": ":not([type='importmap' i]):not([type='speculationrules' i])[src]"
		},
		// https://html.spec.whatwg.org/multipage/scripting.html#attr-script-charset
		// Must not be used without src
		"charset": {
			"condition": "[src]"
		},
		// https://html.spec.whatwg.org/multipage/urls-and-fetching.html#blocking-attributes
		// HTML LS §4.12.1 attribute applicability table: `blocking` is "Yes" for
		// external classic scripts and external module scripts; all inline scripts,
		// import map, speculation rules, and data block are "·" (not applicable).
		// Known gap: same as `defer` — `<script type="application/json" src=x blocking=render>`
		// passes this condition. Acceptable for now — no fixture exercises it.
		"blocking": {
			"type": {
				"token": {
					"enum": ["render"]
				},
				"separator": "space",
				"unique": true
			},
			"condition": ":not([type='importmap' i]):not([type='speculationrules' i])[src]"
		},
		// NOTE: crossorigin, referrerpolicy, and fetchpriority should be
		// disallowed on importmap/speculationrules per spec, but overriding
		// global category attrs here drops the type definition (enum values).
		// This needs architecture support for per-element conditions on
		// global attributes. See #3631.
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false,
		"properties": false
	}
}
