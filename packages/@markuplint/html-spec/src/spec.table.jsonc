// https://html.spec.whatwg.org/multipage/tables.html#the-table-element
// https://www.w3.org/TR/html-aria/#el-table
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": ":model(script-supporting)"
			},
			{
				"optional": "caption"
			},
			{
				"zeroOrMore": ":model(script-supporting)"
			},
			{
				"zeroOrMore": "colgroup"
			},
			{
				"zeroOrMore": ":model(script-supporting)"
			},
			{
				"optional": "thead"
			},
			{
				"zeroOrMore": ":model(script-supporting)"
			},
			{
				"choice": [
					[
						{
							"zeroOrMore": "tbody"
						}
					],
					[
						{
							"oneOrMore": "tr"
						}
					]
				]
			},
			{
				"zeroOrMore": ":model(script-supporting)"
			},
			{
				"optional": "tfoot"
			},
			{
				"zeroOrMore": ":model(script-supporting)"
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"datapagesize": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"summary": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"datasrc": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"dataformatas": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"align": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"bgcolor": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"border": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"bordercolor": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"cellpadding": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"cellspacing": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"frame": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"height": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"rules": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"width": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"background": {
			"obsolete": true
		}
	},
	"aria": {
		"implicitRole": "table",
		"permittedRoles": true
	}
}
