// https://html.spec.whatwg.org/multipage/grouping-content.html#the-div-element
// https://www.w3.org/TR/html-aria/#el-div
{
	"contentModel": {
		"contents": [
			{
				"oneOrMore": ":model(flow)"
			}
		],
		"conditional": [
			{
				// > If the element is a child of a dl element:
				// > One or more dt elements followed by one or more dd elements,
				// > optionally intermixed with script-supporting elements.
				// @see https://html.spec.whatwg.org/multipage/grouping-content.html#the-div-element
				//
				// One group per `<div>`, not repeatable — the group repetition lives at the
				// `<dl>` level, not inside each `<div>`. Why the script-supporting elements are
				// written this way: see spec.dl.jsonc.
				"condition": "dl > div",
				"contents": [
					{
						"zeroOrMore": ":model(script-supporting)"
					},
					{
						"oneOrMore": "dt"
					},
					{
						"zeroOrMore": ["dt", ":model(script-supporting)"]
					},
					{
						"oneOrMore": "dd"
					},
					{
						"zeroOrMore": ["dd", ":model(script-supporting)"]
					}
				]
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {},
	"aria": {
		"implicitRole": "generic",
		"permittedRoles": true,
		"namingProhibited": true,
		"conditions": {
			"dl > div": {
				"permittedRoles": ["presentation", "none"]
			}
		},
		"1.1": {
			"implicitRole": false,
			"permittedRoles": true
		}
	}
}
