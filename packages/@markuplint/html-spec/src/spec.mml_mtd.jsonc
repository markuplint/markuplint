// https://www.w3.org/TR/mathml-core/#entry-in-table-or-matrix-mtd
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [
					":model(MathMLPresentation)",
					"mml|semantics",
					"mml|annotation",
					"mml|annotation-xml",
					"#text"
				]
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#MathMLGlobalAttrs": true
	},
	"attributes": {
		// https://www.w3.org/TR/mathml-core/#entry-in-table-or-matrix-mtd
		"columnspan": {
			"type": {
				"type": "integer",
				"gt": 0
			}
		},
		// https://www.w3.org/TR/mathml-core/#entry-in-table-or-matrix-mtd
		"rowspan": {
			"type": {
				"type": "integer",
				"gt": 0
			}
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": true
	}
}
