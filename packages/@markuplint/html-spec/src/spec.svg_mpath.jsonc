// https://svgwg.org/specs/animations/#MPathElement
// https://www.w3.org/TR/svg-aam/#role-map-mpath
{
	"contentModel": {
		"contents": [
			{
				"zeroOrMore": [":model(SVGDescriptive)", "svg|script"]
			}
		]
	},
	"globalAttrs": {
		"#SVGCoreAttrs": [
			"id",
			"tabindex",
			"autofocus",
			"lang",
			"xml:space",
			"class",
			"style",
			"part",
			"exportparts",
			"slot",
			"nonce",
			"elementtiming"
		],
		"#GlobalEventAttrs": true,
		"#XLinkAttrs": ["xlink:href"]
	},
	"attributes": {
		// https://svgwg.org/specs/animations/#MPathElementHrefAttribute
		"href": {
			"type": "URL"
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": false
	}
}
