// https://html.spec.whatwg.org/multipage/embedded-content.html#the-img-element
// https://www.w3.org/TR/html-aria/#el-img
{
	"contentModel": {
		"contents": false
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#HTMLEmbededAndMediaContentAttrs": ["src", "height", "srcset", "sizes", "width"],
		"#HTMLLinkAndFetchingAttrs": ["crossorigin", "referrerpolicy", "loading", "fetchpriority"]
	},
	"attributes": {
		// https://html.spec.whatwg.org/multipage/embedded-content.html#attr-img-alt
		"alt": {
			"type": "Any"
		},
		// https://html.spec.whatwg.org/multipage/embedded-content.html#attr-img-src
		"src": {
			"type": "NonEmptyURL",
			"requiredEither": ["srcset"]
		},
		// https://html.spec.whatwg.org/multipage/embedded-content.html#attr-img-srcset
		"srcset": {
			"type": "Srcset",
			"requiredEither": ["src"]
		},
		// @see https://html.spec.whatwg.org/multipage/embedded-content.html#attr-img-sizes
		// > If the srcset attribute is present and has any image candidate strings using a width
		// > descriptor, the sizes attribute must also be present. If the srcset attribute is not
		// > specified, and the loading attribute is in the Lazy state, the sizes attribute may be
		// > specified with the value "auto" (ASCII case-insensitive).
		// Without srcset, sizes is allowed only on a lazily loaded image, and only as the
		// value "auto". The value is checked by the type, not by the condition: a condition
		// that names an attribute with a dynamic value is not evaluated at all, so naming
		// sizes in it would stop a dynamic sizes from being reported on an image that is not
		// lazily loaded.
		"sizes": {
			"type": [
				{ "condition": "[srcset]", "type": "SourceSizeList" },
				{ "condition": ":not([srcset])", "type": { "enum": ["auto"] } }
			],
			"condition": "[srcset], [loading='lazy' i]"
		},
		// https://html.spec.whatwg.org/multipage/image-maps.html#attr-hyperlink-usemap
		"usemap": {
			"type": "HashName",
			"condition": ":is(:not(a):not(button)) img"
		},
		// https://html.spec.whatwg.org/multipage/embedded-content.html#attr-img-ismap
		"ismap": {
			"type": "Boolean",
			"condition": "a[href] img"
		},
		// https://html.spec.whatwg.org/multipage/embedded-content.html#attr-img-decoding
		"decoding": {
			"type": {
				"enum": ["sync", "async", "auto"],
				"invalidValueDefault": "auto",
				"missingValueDefault": "auto"
			}
		}
	},
	"aria": {
		"implicitRole": "img",
		"permittedRoles": [
			"button",
			"checkbox",
			"link",
			"math",
			"menuitem",
			"menuitemcheckbox",
			"menuitemradio",
			"meter",
			"option",
			"progressbar",
			"radio",
			"scrollbar",
			"separator",
			"slider",
			"switch",
			"tab",
			"treeitem"
		],
		"conditions": {
			"[alt=\"\"]": {
				"implicitRole": "presentation",
				"permittedRoles": false,
				"properties": {
					"only": [
						{
							"name": "aria-hidden",
							"value": "true"
						}
					]
				}
			},
			":not([alt]):aria(has no name)": {
				"implicitRole": "img",
				"permittedRoles": false,
				"properties": {
					"only": [
						{
							"name": "aria-hidden",
							"value": "true"
						}
					]
				}
			}
		},
		"1.1": {
			"permittedRoles": [
				"button",
				"checkbox",
				"link",
				"menuitem",
				"menuitemcheckbox",
				"menuitemradio",
				"option",
				"progressbar",
				"scrollbar",
				"separator",
				"slider",
				"switch",
				"tab",
				"treeitem"
			]
		}
	}
}
