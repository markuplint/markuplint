// https://html.spec.whatwg.org/multipage/tables.html#the-thead-element
// https://www.w3.org/TR/html-aria/#el-thead
{
	"contentModel": {
		"contents": [
			{
				// > Zero or more tr and script-supporting elements.
				// @see https://html.spec.whatwg.org/multipage/tables.html#the-thead-element
				"zeroOrMore": ["tr", ":model(script-supporting)"]
			}
		]
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"align": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"char": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"charoff": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"height": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"valign": {
			"obsolete": true
		},
		// https://html.spec.whatwg.org/multipage/obsolete.html#non-conforming-features
		"background": {
			"obsolete": true
		}
	},
	"aria": {
		"implicitRole": "rowgroup",
		"permittedRoles": true
	}
}
