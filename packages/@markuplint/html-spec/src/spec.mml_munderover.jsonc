// https://www.w3.org/TR/mathml-core/#underscripts-and-overscripts-munder-mover-munderover
{
	"contentModel": {
		"contents": [
			{
				// MathML Core §3.4.2 — munderover requires exactly three children
				// (base, underscript, overscript).
				"require": [
					":model(MathMLPresentation)",
					"mml|semantics",
					"mml|annotation",
					"mml|annotation-xml",
					"#text"
				],
				"min": 3,
				"max": 3
			}
		]
	},
	"globalAttrs": {
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true,
		"#MathMLGlobalAttrs": true
	},
	"attributes": {
		// https://www.w3.org/TR/mathml-core/#underscripts-and-overscripts-munder-mover-munderover
		"accent": {
			"type": {
				"enum": ["true", "false"],
				"disallowToSurroundBySpaces": false
			}
		},
		// https://www.w3.org/TR/mathml-core/#underscripts-and-overscripts-munder-mover-munderover
		"accentunder": {
			"type": {
				"enum": ["true", "false"],
				"disallowToSurroundBySpaces": false
			}
		}
	},
	"aria": {
		"implicitRole": false,
		"permittedRoles": true
	}
}
