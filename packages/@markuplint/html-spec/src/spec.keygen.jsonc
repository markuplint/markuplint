{
	"obsolete": true,
	"contentModel": {
		"contents": true
	},
	"globalAttrs": {
		"#HTMLGlobalAttrs": true,
		"#GlobalEventAttrs": true,
		"#ARIAAttrs": true
	},
	"attributes": {},
	"aria": {
		"permittedRoles": true,
		"implicitRole": false
	}
}
