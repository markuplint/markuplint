{
	"name": "@markuplint/html-spec",
	"version": "5.4.0",
	"description": "A specification of HTML Living Standard for markuplint",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/html-spec"
	},
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"main": "index.js",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./json": "./index.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"gen": "npm-run-all gen:build gen:format",
		"gen:build": "node build.ts",
		"gen:format": "npx oxfmt --write index.json"
	},
	"devDependencies": {
		"@markuplint/test-tools": "5.4.0",
		"@types/cli-progress": "3.11.6",
		"cheerio": "1.2.0",
		"cli-progress": "3.12.0",
		"domhandler": "5.0.3",
		"glob": "14.0.2",
		"jsonc-parser": "3.3.1",
		"type-fest": "5.10.0"
	},
	"dependencies": {
		"@markuplint/ml-spec": "5.4.0"
	}
}
