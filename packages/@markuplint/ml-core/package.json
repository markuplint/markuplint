{
	"name": "@markuplint/ml-core",
	"version": "5.3.0",
	"description": "The core module of markuplint",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/ml-core"
	},
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"typedoc": {
		"entryPoint": "./src/index.ts"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --watch --project tsconfig.build.json",
		"clean": "tsc --build --clean tsconfig.build.json"
	},
	"browser": {
		"./lib/configs.js": "./lib/configs.browser.js"
	},
	"dependencies": {
		"@markuplint/config-presets": "5.3.0",
		"@markuplint/html-parser": "5.3.0",
		"@markuplint/html-spec": "5.3.0",
		"@markuplint/i18n": "5.3.0",
		"@markuplint/ml-ast": "5.3.0",
		"@markuplint/ml-config": "5.3.0",
		"@markuplint/ml-spec": "5.3.0",
		"@markuplint/parser-utils": "5.3.0",
		"@markuplint/selector": "5.3.0",
		"@markuplint/shared": "5.3.0",
		"@types/debug": "^4.1.13",
		"debug": "^4.4.3",
		"is-plain-object": "^5.1.0",
		"type-fest": "^5.10.0"
	}
}
