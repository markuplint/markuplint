{
	"name": "@markuplint/core",
	"version": "5.0.0-rc.1",
	"description": "Rust-based linting engine for markuplint (NAPI native addon)",
	"type": "module",
	"main": "./index.cjs",
	"types": "./index.d.ts",
	"files": [
		"index.cjs",
		"index.d.ts",
		"*.node"
	],
	"napi": {
		"binaryName": "markuplint"
	},
	"scripts": {
		"build:napi": "napi build --release --manifest-path ../../../crates/markuplint-builder/Cargo.toml --output-dir . --platform",
		"build:napi:debug": "napi build --manifest-path ../../../crates/markuplint-builder/Cargo.toml --output-dir . --platform"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.0.0"
	}
}
