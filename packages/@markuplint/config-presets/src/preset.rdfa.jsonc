{
	"nodeRules": [
		{
			/**
			 * Allow `property` attr with `<meta>`
			 *
			 * Be able to use **Open-Graph** etc.
			 */
			"name": "rdfa/meta-property",
			"specConformance": "non-normative",
			"selector": ":where(meta[property])",
			"rules": {
				"invalid-attr": {
					"options": {
						"allowAttrs": [
							{
								"name": "property",
								"value": "NoEmptyAny"
							},
							{
								"name": "content",
								"value": "NoEmptyAny"
							}
						]
					}
				},
				"required-attr": false
			}
		}
	]
}
