{
	"rules": {
		/**
		 * Must not duplicate **ID**
		 *
		 * Be able to avoid problems in assistive technologies from the viewpoint of machine readability.
		 *
		 * @see https://www.w3.org/WAI/WCAG21/Techniques/html/H93.html
		 */
		"id-duplication": true,

		"invalid-attr": {
			"options": {
				"disallowAttrs": [
					/**
					 * Disallow `accesskey` attr
					 *
					 * @see https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/accesskey#accessibility_concerns
					 */
					"accesskey"
				]
			}
		},

		/**
		 * `<label>` should have control
		 *
		 */
		"label-has-control": true,

		/**
		 * Use **landmark**
		 *
		 * @see https://www.w3.org/TR/wai-aria-practices/examples/landmarks/
		 */
		"landmark-roles": true,

		/**
		 * **Popover** trigger and target must be adjacent
		 *
		 */
		"neighbor-popovers": true,

		/**
		 * No ambiguous **Navigable Target Names**
		 *
		 * @see https://html.spec.whatwg.org/multipage/document-sequences.html#navigable-target-names
		 */
		"no-ambiguous-navigable-target-names": true,

		/**
		 * No consecutive `<br>`
		 */
		"no-consecutive-br": true,

		/**
		 * No refer to no existent **ID**
		 */
		"no-refer-to-non-existent-id": true,

		/**
		 * No redundant **accessible name** sources
		 */
		"redundant-accessible-name": true,

		/**
		 * Require **accessible name**
		 */
		"require-accessible-name": true,

		/**
		 * Require **autofocus** in modal dialogs
		 */
		"require-dialog-autofocus": true,

		/**
		 * Require `<h1>`
		 *
		 */
		"required-h1": true,

		/**
		 * Align row and column
		 *
		 */
		"table-row-column-alignment": true,

		/**
		 * Use `<ul>`
		 *
		 */
		"use-list": true,

		/**
		 * Conform to **WAI-ARIA**
		 *
		 */
		"wai-aria": true
	},
	"nodeRules": [
		{
			/**
			 * Require `<html lang>`
			 */
			"name": "a11y/html-lang",
			"selector": ":where(html)",
			"rules": {
				"required-attr": ["lang"]
			}
		},
		{
			/**
			 * Require `<abbr title>`
			 */
			"name": "a11y/abbr-title",
			"selector": ":where(abbr)",
			"rules": {
				"required-attr": ["title"]
			}
		},
		{
			/**
			 * Require `<track>` in media elements
			 */
			"name": "a11y/media-track",
			"selector": ":where(video, audio)",
			"rules": {
				"required-element": ["track"]
			}
		},
		{
			/**
			 * Require `<video muted>` when autoplay is set
			 */
			"name": "a11y/video-autoplay-muted",
			"selector": ":where(video[autoplay])",
			"rules": {
				"required-attr": ["muted"]
			}
		},
		{
			/**
			 * No merge cells
			 */
			"name": "a11y/no-merge-cells",
			"selector": ":where(th, td)",
			"rules": {
				"invalid-attr": {
					"options": {
						"disallowAttrs": ["colspan", "rowspan"]
					}
				}
			}
		},
		{
			/**
			 * `<summary>` must not contain interactive contents
			 *
			 * There is a case where an assistive technology can't access contents,
			 * or contents don't propagate a mouse event to `<summary>`.
			 *
			 * @see https://github.com/whatwg/html/issues/2272#issuecomment-1242415594
			 */
			"name": "a11y/summary-no-interactive",
			"selector": ":where(summary)",
			"rules": {
				"disallowed-element": [":model(interactive)"]
			}
		},
		{
			/**
			 * Disallow `autofocus` attr outside dialog scope
			 *
			 * Don't take away focus by force. The `dialog` element
			 * and its descendants are excepted.
			 *
			 * @see https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/autofocus#accessibility_considerations
			 */
			"name": "a11y/no-autofocus-outside-dialog",
			"selector": ":where(:not(dialog, dialog *))",
			"rules": {
				"invalid-attr": {
					"options": {
						"disallowAttrs": ["autofocus"]
					}
				}
			}
		},
		{
			/**
			 * `tabindex` attr only `-1` or `0`
			 *
			 * Scoped to non-dialog elements because the HTML spec
			 * disallows `tabindex` on `<dialog>` (`noUse`).
			 *
			 * @see https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes/tabindex#accessibility_concerns
			 */
			"name": "a11y/tabindex-restrict",
			"selector": ":where(:not(dialog))",
			"rules": {
				"invalid-attr": {
					"options": {
						"allowAttrs": [
							{
								"name": "tabindex",
								"value": {
									"enum": ["-1", "0"]
								}
							}
						]
					}
				}
			}
		},
		{
			"selector": ":where(meta[name='viewport' i])",
			"rules": {
				"invalid-attr": {
					"options": {
						"disallowAttrs": [
							{
								/**
								 * Disallow `user-scalable=no` in viewport meta
								 *
								 * Usage of `user-scalable=no` can cause accessibility issues
								 * to users with visual impairments such as low vision.
								 * WCAG requires a minimum of 2× scaling.
								 *
								 * @see https://developer.mozilla.org/en-US/docs/Web/HTML/Viewport_meta_tag
								 * @see https://dequeuniversity.com/rules/axe/4.4/meta-viewport
								 */
								"name": "content",
								"value": {
									"pattern": "/user-scalable\\s*=\\s*(no|0)\\b/i"
								}
							}
						]
					}
				}
			}
		}
	]
}
