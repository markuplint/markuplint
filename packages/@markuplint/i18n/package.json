{
	"name": "@markuplint/i18n",
	"version": "5.0.0-rc.4",
	"description": "Internationalization for markuplint",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/i18n"
	},
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"main": "./cjs/index.js",
	"types": "./cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"default": "./esm/index.mjs",
				"types": "./esm/index.d.ts"
			},
			"require": "./cjs/index.js"
		},
		"./locales/en.json": {
			"import": "./locales/en.json",
			"require": "./locales/en.json"
		},
		"./locales/ja.json": {
			"import": "./locales/ja.json",
			"require": "./locales/ja.json"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"typedoc": {
		"entryPoint": "./src/index.ts"
	},
	"scripts": {
		"build": "yarn build:esm && yarn build:cjs && node ./esm.mjs",
		"build:esm": "npx tsc --project tsconfig.build.json",
		"build:cjs": "npx tsc --project tsconfig.build-cjs.json",
		"clean": "yarn clean:esm && yarn clean:cjs",
		"clean:esm": "npx tsc --build --clean tsconfig.build.json",
		"clean:cjs": "npx tsc --build --clean tsconfig.build-cjs.json"
	}
}
