{
	"name": "@markuplint/selector",
	"version": "5.2.0",
	"description": "Extended W3C Selectors matcher",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/selector"
	},
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/index.js",
			"types": "./lib/index.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"typedoc": {
		"entryPoint": "./src/index.ts"
	},
	"scripts": {
		"build": "npx tsc --project tsconfig.build.json",
		"dev": "npx tsc --watch --project tsconfig.build.json",
		"clean": "npx tsc --build --clean tsconfig.build.json"
	},
	"dependencies": {
		"@markuplint/ml-spec": "5.2.0",
		"@markuplint/shared": "5.2.0",
		"@types/debug": "^4.1.13",
		"debug": "^4.4.3",
		"postcss-selector-parser": "^7.1.6",
		"type-fest": "^5.10.0"
	},
	"devDependencies": {
		"@types/jsdom": "30.0.0",
		"jsdom": "30.1.2"
	}
}
