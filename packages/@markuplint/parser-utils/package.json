{
	"name": "@markuplint/parser-utils",
	"version": "5.3.0",
	"description": "Utility module for markuplint parser plugin",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/parser-utils"
	},
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./location": {
			"types": "./lib/get-location.d.ts",
			"default": "./lib/get-location.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"typedoc": {
		"entryPoint": "./src/index.ts"
	},
	"scripts": {
		"build": "npx tsc --project tsconfig.build.json",
		"dev": "npx tsc --watch --project tsconfig.build.json",
		"clean": "npx tsc --build --clean tsconfig.build.json"
	},
	"dependencies": {
		"@markuplint/ml-ast": "5.3.0",
		"@markuplint/ml-spec": "5.3.0",
		"@markuplint/shared": "5.3.0",
		"@markuplint/types": "5.3.0",
		"debug": "^4.4.3",
		"espree": "^11.2.0",
		"type-fest": "^5.10.0"
	},
	"devDependencies": {
		"@typescript-eslint/typescript-estree": "8.71.2"
	}
}
