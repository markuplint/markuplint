{
	"name": "@markuplint/file-resolver",
	"version": "5.3.0",
	"description": "The file resolver of markuplint",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/file-resolver"
	},
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"typedoc": {
		"entryPoint": "./src/index.ts"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --watch --project tsconfig.build.json",
		"clean": "tsc --build --clean"
	},
	"devDependencies": {
		"@types/node": "24.19.2"
	},
	"dependencies": {
		"@markuplint/html-parser": "5.3.0",
		"@markuplint/ml-ast": "5.3.0",
		"@markuplint/ml-config": "5.3.0",
		"@markuplint/ml-core": "5.3.0",
		"@markuplint/ml-spec": "5.3.0",
		"@markuplint/parser-utils": "5.3.0",
		"@markuplint/pretenders": "5.3.0",
		"@markuplint/selector": "5.3.0",
		"@markuplint/shared": "5.3.0",
		"cosmiconfig": "^10.0.1",
		"debug": "^4.4.3",
		"glob": "^13.0.6",
		"ignore": "^7.0.12",
		"import-meta-resolve": "^4.2.0",
		"jsonc": "^3.0.0",
		"minimatch": "^10.2.6"
	}
}
