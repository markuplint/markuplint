{
	"pretenders": [
		{ "selector": "Item", "as": "li", "filePath": "./Item.tsx:1:17" },
		{ "selector": "Bare", "as": "li", "filePath": "./Bare.tsx" },
		{ "selector": "Plain", "as": "div" }
	],
	"overrides": {
		"./*.html": {
			"parser": { "\\.x$": "./parser.js", "\\.y$": "@markuplint/jsx-parser" },
			"specs": { "\\.x$": "./spec.js" },
