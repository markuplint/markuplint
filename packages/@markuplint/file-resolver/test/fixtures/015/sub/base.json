			"excludeFiles": ["./ignored/**", "!./ignored/keep/**"],
			"pretenders": {
				"files": ["./pretenders.json"],
				"scan": [{ "files": "./components/*.tsx" }, { "files": ["./ui/*.tsx", "./ui/*.jsx"] }],
				"data": [{ "selector": "Over", "as": "li", "filePath": "./Over.tsx:3:4" }]
			}
		}
	}
