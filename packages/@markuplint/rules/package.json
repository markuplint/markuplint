{
	"name": "@markuplint/rules",
	"version": "5.3.0",
	"description": "Built-in rules of markuplint",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/rules"
	},
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "npx tsc --project tsconfig.build.json",
		"dev": "npx tsc --watch --project tsconfig.build.json",
		"clean": "npx tsc --build --clean tsconfig.build.json"
	},
	"browser": {
		"./lib/permitted-contents/debug.js": "./lib/permitted-contents/debug.browser.js"
	},
	"dependencies": {
		"@markuplint/html-spec": "5.3.0",
		"@markuplint/ml-config": "5.3.0",
		"@markuplint/ml-core": "5.3.0",
		"@markuplint/ml-spec": "5.3.0",
		"@markuplint/selector": "5.3.0",
		"@markuplint/shared": "5.3.0",
		"@markuplint/types": "5.3.0",
		"@mdn/browser-compat-data": "^8.1.5",
		"@types/debug": "^4.1.13",
		"ansi-colors": "^4.1.3",
		"browserslist": "^4.29.3",
		"chrono-node": "^2.10.3",
		"debug": "^4.4.3",
		"image-size": "^2.0.4",
		"type-fest": "^5.10.0"
	}
}
