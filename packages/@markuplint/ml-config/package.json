{
	"name": "@markuplint/ml-config",
	"version": "5.6.1",
	"description": "JSON Schema and TypeScript types of markuplint configure JSON",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/ml-config"
	},
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "MIT",
	"engines": {
		"node": ">=26"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "npx tsc --project tsconfig.build.json",
		"dev": "npx tsc --watch --project tsconfig.build.json",
		"clean": "npx tsc --build --clean  tsconfig.build.json"
	},
	"dependencies": {
		"@markuplint/ml-ast": "5.6.0",
		"@markuplint/ml-spec": "5.6.1",
		"@markuplint/selector": "5.6.1",
		"@markuplint/shared": "5.6.0",
		"@types/mustache": "^4.2.6",
		"is-plain-object": "^5.1.0",
		"mustache": "^4.2.0",
		"type-fest": "^5.10.0"
	}
}
