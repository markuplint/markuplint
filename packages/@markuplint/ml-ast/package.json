{
	"name": "@markuplint/ml-ast",
	"version": "5.0.0-rc.4",
	"description": "The markuplint AST types.",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/ml-ast"
	},
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/index.js",
			"types": "./lib/index.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"typedoc": {
		"entryPoint": "./src/index.ts"
	},
	"scripts": {
		"build": "npx tsc --project tsconfig.build.json",
		"dev": "npx tsc --watch --project tsconfig.build.json",
		"clean": "npx tsc --build --clean  tsconfig.build.json"
	}
}
