{
	"name": "@markuplint/vue-spec",
	"version": "5.2.0",
	"description": "Extended specification for tags and attributes in Vue",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/vue-spec"
	},
	"author": "Yusuke Hirao <yusukehirao@me.com>",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "npx tsc --project tsconfig.build.json",
		"dev": "npx tsc --watch --project tsconfig.build.json",
		"clean": "npx tsc --build --clean tsconfig.build.json"
	},
	"dependencies": {
		"@markuplint/ml-spec": "5.2.0"
	}
}
