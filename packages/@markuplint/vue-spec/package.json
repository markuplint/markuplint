{
	"name": "@markuplint/vue-spec",
	"version": "5.0.0-rc.4",
	"description": "Extended specification for tags and attributes in Vue",
	"repository": {
		"type": "git",
		"url": "https://github.com/markuplint/markuplint.git",
		"directory": "packages/@markuplint/vue-spec"
	},
