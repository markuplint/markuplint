{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "ExcludedIds",
	"type": "object",
	"additionalProperties": false,
	"required": ["entries"],
	"properties": {
		"$schema": { "type": "string" },
		"entries": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "path", "nuMessage", "reason", "specUrl", "addedAt", "addedBy"],
				"properties": {
					"id": { "type": "string", "pattern": "^nv-[0-9a-f]{12}(-[0-9]+)?$" },
					"path": { "type": "string" },
					"nuMessage": { "type": "string" },
					"reason": { "type": "string" },
					"specUrl": { "type": "string", "format": "uri" },
					"addedAt": { "type": "string", "format": "date" },
					"addedBy": { "type": "string" }
				}
			}
		},
		"patterns": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["messageContains", "reason", "specUrl", "addedAt", "addedBy"],
				"properties": {
					"messageContains": { "type": "string", "minLength": 1 },
					"reason": { "type": "string" },
					"specUrl": { "type": "string", "format": "uri" },
					"addedAt": { "type": "string", "format": "date" },
					"addedBy": { "type": "string" }
				}
			}
		}
	}
}
