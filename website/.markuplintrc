{
  "excludeFiles": ["./node_modules/**/*"],
  "extends": ["markuplint:recommended-react"],
  "parser": {
    ".tsx$": "@markuplint/jsx-parser"
  },
  "specs": {
    ".tsx$": "@markuplint/react-spec"
  },
  "pretenders": {
    "scan": [{ "files": "./src/**/*.tsx" }]
  },
  "rules": {
    "no-skipped-heading-level": false
  },
  "nodeRules": [
    {
      "selector": "meta[property]",
      "rules": {
        "invalid-attr": {
          "options": {
            "allowAttrs": ["property", "content"]
          }
        },
        "require-attr": false
      }
    },
    {
      "selector": "style",
      "rules": {
        "invalid-attr": {
          "options": {
            "allowAttrs": [
              {
                "name": "jsx",
                "value": {
                  "type": "Boolean"
                }
              }
            ]
          }
        }
      }
    }
  ],
  "overrideMode": "merge",
  "overrides": {
    "**/OgImgPlayground.tsx": {
      "nodeRules": [
        {
          "selector": "img",
          "rules": {
            "require-attr": false
          }
        }
      ]
    }
  }
}
