{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"configMigration": true,
	"extends": [
		"config:recommended",
		"docker:pinDigests",
		"helpers:pinGitHubActionDigests",
		":pinDevDependencies",
		":semanticCommitTypeAll(chore)"
	],
	"baseBranchPatterns": [
		"dev",
		"v6",
		"v4"
	],
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true
	},
	"minimumReleaseAge": "7 days",
	"internalChecksFilter": "strict",
	"osvVulnerabilityAlerts": true,
	"vulnerabilityAlerts": {
		"minimumReleaseAge": null
	},
	"autoApprove": true,
	"labels": ["Dependencies", "Renovate"],
	"packageRules": [
		{
			"matchDepTypes": ["optionalDependencies"],
			"addLabels": ["Dependencies: Optional"]
		},
		{
			"matchDepTypes": ["devDependencies"],
			"addLabels": ["Dependencies: Development"]
		},
		{
			"matchDepTypes": ["dependencies"],
			"addLabels": ["Dependencies: Production"]
		},
		{
			"description": "Automerge non-major updates",
			"matchUpdateTypes": ["minor", "patch", "pin", "digest"],
			"matchCurrentVersion": "!/^0/",
			"automerge": true
		},
		{
			"matchFileNames": ["vscode/*"],
			"ignoreDeps": ["@types/node", "@types/vscode"]
		},
		{
			"matchFileNames": ["packages/**/*"],
			"ignoreDeps": ["default-markuplint", "test-markuplint"]
		},
		{
			"description": "Raise the lower bound of ranges in published packages on each update, so a consumer's install cannot dedupe onto a version older than the one we last released against",
			"matchFileNames": ["packages/**/*"],
			"matchDepTypes": ["dependencies"],
			"rangeStrategy": "bump"
		},
		{
			"description": "test-tools is private; its dependencies stay exact like devDependencies",
			"matchFileNames": ["packages/@markuplint/test-tools/package.json"],
			"rangeStrategy": "pin"
		},
		{
			"matchFileNames": ["package.json"],
			"ignoreDeps": ["string-width", "strip-ansi", "wrap-ansi"]
		},
		{
			"matchPackageNames": ["node"],
			"matchManagers": ["dockerfile"],
			"enabled": false
		},
		{
			"description": "Renovate reads this file from the default branch only, so it also governs the Cargo workspace that exists only on v6. Lock file maintenance regenerates Cargo.lock with every crate at its newest version and bypasses minimumReleaseAge; npm closes that gap inside the package manager (npmMinimalAgeGate in .yarnrc.yml), Cargo has no equivalent until registry.global-min-publish-age (Rust 1.100) is configured on v6. Re-enable once it is.",
			"matchManagers": ["cargo"],
			"matchUpdateTypes": ["lockFileMaintenance"],
			"enabled": false
		},
		{
			"description": "Separate mise node updates from GitHub Actions node-version",
			"matchPackageNames": ["node"],
			"matchManagers": ["mise"],
			"groupName": "node (mise)"
		},
		{
			"description": "Do not update engines.vscode — must stay pinned for Cursor and other forks",
			"matchPackageNames": ["vscode"],
			"matchDepTypes": ["engines"],
			"enabled": false
		}
	]
}
