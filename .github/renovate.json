{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"configMigration": true,
	"extends": [
		"config:recommended",
		"docker:pinDigests",
		"helpers:pinGitHubActionDigests",
		":pinDevDependencies",
		":semanticCommitTypeAll(chore)"
	],
	"baseBranches": ["dev", "v4"],
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true
	},
	"autoApprove": true,
	"labels": ["Dependencies", "Renovate"],
	"packageRules": [
		{
			"matchDepTypes": ["optionalDependencies"],
			"addLabels": ["Dependencies: Optional"]
		},
		{
			"matchDepTypes": ["devDependencies"],
			"addLabels": ["Dependencies: Development"]
		},
		{
			"matchDepTypes": ["dependencies"],
			"addLabels": ["Dependencies: Production"]
		},
		{
			"description": "Automerge non-major updates",
			"matchUpdateTypes": ["minor", "patch", "pin", "digest"],
			"matchCurrentVersion": "!/^0/",
			"automerge": true
		},
		{
			"matchFileNames": ["vscode/*"],
			"ignoreDeps": ["@types/node", "@types/vscode"]
		},
		{
			"matchFileNames": ["packages/**/*"],
			"ignoreDeps": ["default-markuplint", "test-markuplint"]
		},
		{
			"matchFileNames": ["package.json"],
			"ignoreDeps": ["string-width", "strip-ansi", "wrap-ansi"]
		},
		{
			"matchPackageNames": ["node"],
			"matchManagers": ["dockerfile"],
			"enabled": false
		},
		{
			"description": "Separate mise node updates from GitHub Actions node-version",
			"matchPackageNames": ["node"],
			"matchManagers": ["mise"],
			"groupName": "node (mise)"
		},
		{
			"description": "Pin VSCode CI workflows to Node 22 — do not update",
			"matchPackageNames": ["node"],
			"matchFileNames": [".github/workflows/*vscode*"],
			"enabled": false
		},
		{
			"description": "Do not update engines.vscode — must stay pinned for Cursor and other forks",
			"matchPackageNames": ["vscode"],
			"matchDepTypes": ["engines"],
			"enabled": false
		}
	]
}
